{
  "dataDownloadUrl": [
    "tests/stats/test_data/runner/input/config_driven"
  ],
  "inputFiles": {
    "countries.csv": {
      "importType": "observations",
      "format": "variablePerColumn",
      "entityType": "Country",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:observationAbout": "place",
        "dcid:observationDate": "year"
      }
    },
    "wikidataids.csv": {
      "importType": "observations",
      "format": "variablePerColumn",
      "entityType": "Country",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:observationAbout": "wikidataid",
        "dcid:observationDate": "year"
      }
    },
    "variable_per_row.csv": {
      "importType": "observations",
      "format": "variablePerRow",
      "entityType": "Country",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:variableMeasured": "variable",
        "dcid:observationAbout": "entity",
        "dcid:observationDate": "date",
        "dcid:value": "value"
      }
    },
    "author_entities.csv": {
      "importType": "entities",
      "rowEntityType": "Author",
      "idColumn": "author_id",
      "columnsToResolve": [
        "author_country"
      ],
      "provenance": "dcid:Provenance1"
    },
    "article_entities.csv": {
      "importType": "entities",
      "rowEntityType": "Article",
      "idColumn": "article_id",
      "columnsToResolve": [
        "article_author"
      ],
      "provenance": "dcid:Provenance1"
    },
    "*.mcf": {
      "provenance": "dcid:Provenance1"
    }
  }
}