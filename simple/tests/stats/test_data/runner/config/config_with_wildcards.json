{
  "dataDownloadUrl": [
    "tests/stats/test_data/runner/input/config_with_wildcards"
  ],
  "inputFiles": [
    {
      "pattern": "variable_per_row.csv",
      "importType": "observations",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:variableMeasured": "variable",
        "dcid:observationAbout": "entity",
        "dcid:observationDate": "date",
        "dcid:value": "value"
      }
    },
    {
      "pattern": "countr*.csv",
      "importType": "observations",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:variableMeasured": "variable",
        "dcid:observationAbout": "place",
        "dcid:observationDate": "year",
        "dcid:value": "value"
      },
      "columnsToResolve": [
        "place"
      ]
    },
    {
      "pattern": "wiki*.csv",
      "importType": "observations",
      "provenance": "dcid:Provenance1",
      "columnMappings": {
        "dcid:variableMeasured": "variable",
        "dcid:observationAbout": "wikidataid",
        "dcid:observationDate": "year",
        "dcid:value": "value"
      },
      "columnsToResolve": [
        "wikidataid"
      ]
    },
    {
      "pattern": "*.mcf",
      "provenance": "dcid:Provenance1"
    }
  ]
}
